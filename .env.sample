# Tunect environment template (NO real secrets — copy sections into the right app folder)
#
# Backend:  cp .env.sample backend/.env   then edit backend/.env
# Frontend: cp .env.sample Frontend/.env  then keep only VITE_* lines (see bottom)
# Docker:   use the Docker section in backend/.env or compose overrides
#
# Never commit .env, .env.local, .env.test, .env.preprod, or .env.prod.

# =============================================================================
# BACKEND — copy everything above the FRONTEND section into backend/.env
# =============================================================================

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tunect?schema=public
SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tunect_shadow?schema=public

# Auth / JWT
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=7d
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISS=tunect
JWT_AUD=tunect-users

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
AUTH_GOOGLE_CALLBACK_PATH=/auth/google/callback
AUTH_SUCCESS_REDIRECT=http://localhost:5173/auth/callback
AUTH_FAILURE_REDIRECT=http://localhost:5173/login?error=auth_failed

# Razorpay (test keys for local; use live only in production secrets store)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-test-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
CURRENCY=INR
PURCHASE_MIN_TOKENS=1

# AWS S3 (optional locally — set ENABLE_S3=false to mock)
ENABLE_S3=false
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# OpenAI (optional locally)
ENABLE_OPENAI=false
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# LiveKit
LIVEKIT_HOST=wss://your-livekit-host
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Email — SMTP and/or Microsoft Graph (pick one path)
ENABLE_GRAPH_EMAIL=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
MAIL_FROM=noreply@example.com
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-graph-client-id
GRAPH_CLIENT_SECRET=your-graph-client-secret
GRAPH_SENDER_UPN=noreply@yourdomain.com
GRAPH_SAVE_TO_SENT_ITEMS=true

# Twilio SMS (optional)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+10000000000

# Encryption (must match Frontend VITE_ENCRYPTION_KEY if used)
ENCRYPTION_KEY=base64-encoded-32-byte-key
VITE_ENCRYPTION_KEY=base64-encoded-32-byte-key

# Observability
SENTRY_DSN=
SENTRY_PROFILING=false

# Feature flags
ENABLE_WAITLIST=false
INTERNAL_TESTER_EMAILS=

# Production-only (omit locally)
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# =============================================================================
# FRONTEND — copy only these lines into Frontend/.env (Vite requires VITE_ prefix)
# =============================================================================

VITE_ENV=development
VITE_API_URL=http://localhost:3000
VITE_APP_URL=http://localhost:5173
VITE_USE_MOCKS=true
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
VITE_LIVEKIT_HOST=wss://your-livekit-host
VITE_KYC_USE_PRESIGNED_UPLOADS=false
VITE_ENCRYPTION_KEY=base64-encoded-32-byte-key
VITE_INTERNAL_ONLY=false
VITE_KYC_SUBMIT_TIMEOUT_MS=120000

# =============================================================================
# DOCKER (minimal — often merged into backend/.env for compose)
# =============================================================================

# DATABASE_URL=postgresql://USER:PASSWORD@db:5432/tunect?schema=public
# SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@db:5432/tunect_shadow?schema=public
