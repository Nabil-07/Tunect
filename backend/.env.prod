# ==========================================
# TUNECT - PRODUCTION ENVIRONMENT (AWS)
# ==========================================
# Use this for production deployment at tunectnow.com
# All secrets MUST be stored in AWS Secrets Manager

NODE_ENV=production

# ==========================================
# DATABASE - AWS RDS PostgreSQL
# ==========================================
DATABASE_URL="postgresql://tunect_prod:STRONG_PASSWORD_HERE@tunect-db.xxxxx.us-east-1.rds.amazonaws.com:5432/tunect_production?schema=public&connection_limit=20&pool_timeout=30&connect_timeout=10"
SHADOW_DATABASE_URL="postgresql://tunect_prod:STRONG_PASSWORD_HERE@tunect-db.xxxxx.us-east-1.rds.amazonaws.com:5432/tunect_production_shadow?schema=public"

# ==========================================
# APPLICATION
# ==========================================
APP_URL=https://api.tunectnow.com
FRONTEND_URL=https://tunectnow.com
PORT=3000

# ==========================================
# JWT AUTHENTICATION - PRODUCTION SECRETS
# ==========================================
JWT_SECRET=super-secret
JWT_EXPIRES_IN=30d
JWT_ISS=tunect-api
JWT_AUD=tunect-web
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d

# ==========================================
# GOOGLE OAUTH - Production Credentials
# ==========================================
GOOGLE_CLIENT_ID=61366299037-ca52dnems0271otu47bbdahqbj8r491o.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
AUTH_GOOGLE_CALLBACK_PATH=/auth/google/callback
AUTH_SUCCESS_REDIRECT=/auth/callback
AUTH_FAILURE_REDIRECT=/login?error=google_failed

# ==========================================
# PAYMENT GATEWAY - Razorpay LIVE Mode
# ==========================================
RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY
RAZORPAY_KEY_SECRET=YOUR_LIVE_SECRET
RAZORPAY_WEBHOOK_SECRET=whsec_YOUR_LIVE_WEBHOOK_SECRET
CURRENCY=INR
PURCHASE_MIN_TOKENS=5

# ==========================================
# AWS S3 - PRODUCTION
# ==========================================
ENABLE_S3=true               # Real S3 uploads
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=tunect-production-files
AWS_ACCESS_KEY_ID=FROM_AWS_SECRETS_MANAGER
AWS_SECRET_ACCESS_KEY=FROM_AWS_SECRETS_MANAGER

# ==========================================
# OPENAI - PRODUCTION
# ==========================================
ENABLE_OPENAI=true
OPENAI_API_KEY=sk-PRODUCTION_KEY_FROM_AWS_SECRETS
OPENAI_MODEL=gpt-4o-mini

# ==========================================
# EMAIL / SMTP - Production
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@tunectnow.com
SMTP_PASS=FROM_AWS_SECRETS_MANAGER
MAIL_FROM="Tunect <no-reply@tunectnow.com>"

# ==========================================
# MONITORING & ANALYTICS
# ==========================================
SENTRY_DSN=https://your-production-sentry-dsn@sentry.io/project

# ==========================================
# SMS / NOTIFICATIONS (Optional)
# ==========================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=FROM_AWS_SECRETS_MANAGER
TWILIO_FROM_NUMBER=+1234567890

# ==========================================
# Livekit Configuration
# ==========================================
LIVEKIT_API_KEY=249fc3f1c452325106c8489877667917
LIVEKIT_API_SECRET=a9ccf04d6b76452fe8ea33156a1b32b120892e55ee16d6f5f7bca111ca7d74eb
LIVEKIT_HOST=wss://livekit-preprod.tunectnow.com

# ==========================================
# SECURITY HEADERS
# ==========================================
CORS_ORIGIN=https://tunectnow.com,https://www.tunectnow.com
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100


# ==========================================
# FEATURE FLAGS
# ==========================================
# Waitlist feature - set to 'false' to disable, any other value (or unset) = enabled
ENABLE_WAITLIST=true

# PII Encryption Key (same as frontend)
ENCRYPTION_KEY=cv2aYZO8wkoY+gJeCt3vbnFhOcuK3E3zD1fejypf42E=

# PII Encryption Key (same as backend)
VITE_ENCRYPTION_KEY=cv2aYZO8wkoY+gJeCt3vbnFhOcuK3E3zD1fejypf42E=

# PII Encryption Key (same as frontend)
ENCRYPTION_KEY=cv2aYZO8wkoY+gJeCt3vbnFhOcuK3E3zD1fejypf42E=
# ==========================================
# PRODUCTION DEPLOYMENT NOTES:
# ==========================================
# - Database: AWS RDS PostgreSQL (Multi-AZ)
# - S3: Real AWS S3 bucket for file storage
# - OpenAI: Live API for AI features
# - Payments: Razorpay LIVE mode
# - Domain: tunectnow.com
# - CDN: CloudFront for static assets
# - Load Balancer: AWS ALB
# - Auto Scaling: EC2 or ECS
#
# SECURITY CHECKLIST:
# ✓ All secrets in AWS Secrets Manager
# ✓ SSL/TLS enabled (HTTPS only)
# ✓ Database in private subnet
# ✓ S3 bucket encryption enabled
# ✓ IAM roles with least privilege
# ✓ CloudWatch logging enabled
# ✓ Automated backups configured
# ✓ Rate limiting enabled
# ==========================================
