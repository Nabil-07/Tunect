# Phase 4 Environment Variables
# Add these to your .env file

# ==================== Google Meet Integration ====================
# Google Cloud Service Account credentials for Calendar API
# 1. Go to https://console.cloud.google.com/
# 2. Create or select a project
# 3. Enable "Google Calendar API"
# 4. Create a Service Account
# 5. Download the JSON key file
# 6. Paste the entire JSON content below (as a single line)
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"your-service-account@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}'

# ==================== Waitlist Configuration ====================
# How long (in hours) a waitlist notification is valid before expiring
WAITLIST_NOTIFICATION_EXPIRY_HOURS=24

# ==================== Group Sessions ====================
# Maximum allowed students per group session (optional, defaults to 10)
GROUP_SESSION_MAX_STUDENTS=10

# ==================== Existing Variables (for reference) ====================
# These should already be in your .env file

# Database
DATABASE_URL="postgresql://username:password@127.0.0.1:5432/tunect_db_test"

# JWT
JWT_SECRET="your-secret-key"
JWT_EXPIRATION="7d"

# Tokens
TOKENS_PER_HOUR=1
FEE_PERCENT=20

# Email (if using)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Payment (if using)
RAZORPAY_KEY_ID="your-razorpay-key"
RAZORPAY_KEY_SECRET="your-razorpay-secret"

# ==================== Setup Instructions ====================

# For Google Meet Integration:
# 1. Create Google Cloud project: https://console.cloud.google.com/
# 2. Enable Google Calendar API
# 3. Create Service Account:
#    - Go to "IAM & Admin" > "Service Accounts"
#    - Click "Create Service Account"
#    - Give it a name (e.g., "tunect-calendar")
#    - Grant role "Editor" or "Calendar Admin"
#    - Create JSON key
# 4. Share your Google Calendar with the service account email
# 5. Copy the entire JSON content and paste it as GOOGLE_SERVICE_ACCOUNT_KEY
#    (make sure it's on a single line with escaped quotes)

# Alternative: Use a placeholder for development
# The system will generate placeholder meeting links if Google API is not configured

# For Waitlist:
# - Default expiry is 24 hours
# - Adjust WAITLIST_NOTIFICATION_EXPIRY_HOURS as needed
# - Lower values (6-12h) create urgency
# - Higher values (48-72h) give students more time

# For Group Sessions:
# - Default max is 10 students
# - Can be overridden per session in API
# - Consider your tutors' capacity when setting this
