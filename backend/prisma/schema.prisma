generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Assignment {
  id                      String                    @id @default(cuid())
  tutorId              String
  studentId            String
  bookingId            String?
  title                String
  description          String?
  fileUrl              String?
  fileType             String?
  dueDate              DateTime?
  status               AssignmentStatus       @default(PENDING)
  aiScanStatus         AiScanStatus           @default(PENDING)
  aiScanReason         String?
  isVisibleToStudent   Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt               DateTime                  @default(now()) @updatedAt
  booking              Booking?               @relation(fields: [bookingId], references: [id])
  student              Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutor                Tutor                  @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  assignmentSubmissions AssignmentSubmission[]

  @@index([studentId, status])
  @@index([tutorId, studentId])
  @@index([aiScanStatus])
}

model AssignmentSubmission {
  id                      String                    @id @default(cuid())
  assignmentId String
  fileUrl      String
  notes        String?
  grade        String?
  feedback     String?
  submittedAt  DateTime   @default(now())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
}

model AvailabilitySlot {
  id                      String                    @id @default(cuid())
  tutorId   String
  startTime DateTime
  endTime   DateTime
  title     String?
  createdAt DateTime @default(now())
  tutor     Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([tutorId, startTime, endTime])
  @@index([tutorId, endTime])
  @@index([tutorId, startTime])
}

model BlogPost {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  summary       String?
  content       String
  coverImageUrl String?
  status        BlogStatus @default(DRAFT)
  publishedAt   DateTime?
  authorName    String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt

  @@index([status, publishedAt])
}

model BankImport {
  id                      String                    @id @default(cuid())
  filename   String
  uploadedBy String?
  uploadedAt DateTime  @default(now())
  rowCount   Int       @default(0)
  notes      String?
  User       User?     @relation(fields: [uploadedBy], references: [id])
  BankTxn    BankTxn[]

  @@index([uploadedAt])
}

model BankTxn {
  id                      String                    @id @default(cuid())
  importId   String
  txnDate    DateTime
  valueDate  DateTime?
  narration  String?
  ref        String?
  amount     Decimal    @db.Decimal(18, 2)
  balance    Decimal?   @db.Decimal(18, 2)
  currency   String     @default("INR")
  accountNo  String?
  hash       String     @unique
  paymentId  String?
  BankImport BankImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  Payment    Payment?   @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([ref])
  @@index([txnDate])
}

model Booking {
  id                      String                    @id @default(cuid())
  tutorId                 String
  studentId               String
  startTime               DateTime?
  endTime                 DateTime?
  status                  BookingStatus             @default(PENDING)
  notes                   String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @default(now()) @updatedAt
  isDemo                  Boolean                   @default(false)
  tokensCharged           Decimal                   @default(0.00) @db.Decimal(18, 2)
  editsUsed               Int                       @default(0)
  isGroupSession          Boolean                   @default(false)
  maxStudents             Int                       @default(1)
  currentEnrollment       Int                       @default(1)
  pricePerStudent         Decimal?                  @db.Decimal(18, 2)
  meetingUrl              String?
  meetingProvider         String?                   @default("google_meet")
  recurringTemplateId     String?
  assignments             Assignment[]
  recurringTemplate       RecurringTemplate?        @relation(fields: [recurringTemplateId], references: [id])
  student                 Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutor                   Tutor                     @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  conversations           Conversation[]
  disputes                Dispute[]
  groupParticipants       GroupBookingParticipant[]
  meetingLink             MeetingLink?
  notifications           Notification[]
  reminders               Reminder[]
  review                  Review?
  sessionNotes            SessionNote[]
  tokenLedger             TokenLedger[]
  walletLedger            TutorWalletLedger[]
  waitlist                Waitlist[]
  whiteboardSessions      WhiteboardSession[]
  attendance              BookingAttendance?
  demeritApplied          Boolean?                  @default(false)
  noShowCheckAt           DateTime?
  refundProcessed         Boolean?                  @default(false)

  @@index([isGroupSession, currentEnrollment, maxStudents])
  @@index([recurringTemplateId])
  @@index([status, startTime])
  @@index([studentId, startTime, endTime])
  @@index([tutorId, startTime, endTime])
}

model BookingAttendance {
  id                        String   @id @default(cuid())
  bookingId                 String   @unique
  booking                   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // Waiting room attendance flags (derived at the moment of first join)
  tutorWaitingRoomAttended  Boolean  @default(false)
  studentWaitingRoomAttended Boolean @default(false)

  // Join/leave tracking (supports re-joins)
  tutorJoinCount            Int      @default(0)
  tutorLeaveCount           Int      @default(0)
  tutorFirstJoinedAt        DateTime?
  tutorLastJoinedAt         DateTime?
  tutorLastLeftAt           DateTime?

  studentJoinCount          Int      @default(0)
  studentLeaveCount         Int      @default(0)
  studentFirstJoinedAt      DateTime?
  studentLastJoinedAt       DateTime?
  studentLastLeftAt         DateTime?

  // Derived milestones
  classStartedAt            DateTime?
  classEndedAt              DateTime?

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @default(now()) @updatedAt

  @@index([bookingId])
}

model Certificate {
  id                      String                    @id @default(cuid())
  studentId String
  tutorId   String?
  type      CertificateType
  hours     Decimal         @db.Decimal(10, 2)
  subject   String?
  issuedAt  DateTime        @default(now())
  student   Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutor     Tutor?          @relation(fields: [tutorId], references: [id])

  @@index([studentId, type])
}

model Conversation {
  id                      String                    @id @default(cuid())
  studentId String
  tutorId   String
  bookingId String?
  isArchived Boolean @default(false)
  archivedAt DateTime?
  createdAt DateTime  @default(now())
  booking   Booking?  @relation(fields: [bookingId], references: [id])
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutor     Tutor     @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([studentId, tutorId, bookingId])
  @@index([studentId, tutorId, createdAt])
  @@index([isArchived])
}

model Dispute {
  id                      String                    @id @default(cuid())
  bookingId                     String
  reporterId                    String
  reason                        String
  description                   String
  status                        DisputeStatus @default(OPEN)
  resolution                    String?
  createdAt                     DateTime      @default(now())
  resolvedAt                    DateTime?
  resolvedBy                    String?
  Booking                       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  User_Dispute_reporterIdToUser User          @relation("Dispute_reporterIdToUser", fields: [reporterId], references: [id], onDelete: Cascade)
  User_Dispute_resolvedByToUser User?         @relation("Dispute_resolvedByToUser", fields: [resolvedBy], references: [id])

  @@index([status, createdAt])
}

model EmailCampaign {
  id                      String                    @id @default(cuid())
  name        String
  subject     String
  body        String
  targetRole  Role?
  sentCount   Int       @default(0)
  scheduledAt DateTime?
  sentAt      DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())
  User        User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([scheduledAt, sentAt])
}

model FavoriteTutor {
  id                      String                    @id @default(cuid())
  studentId String
  tutorId   String
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutor     Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([studentId, tutorId])
  @@index([studentId])
}

model GatewayImport {
  id                      String                    @id @default(cuid())
  provider   PaymentProvider
  filename   String
  uploadedBy String?
  uploadedAt DateTime        @default(now())
  rowCount   Int             @default(0)
  notes      String?
  User       User?           @relation(fields: [uploadedBy], references: [id])
  GatewayTxn GatewayTxn[]

  @@index([provider, uploadedAt])
}

model GatewayTxn {
  id                      String                    @id @default(cuid())
  importId      String
  provider      PaymentProvider
  event         String?
  txnDate       DateTime
  ref           String?
  description   String?
  amount        Decimal         @db.Decimal(18, 2)
  fee           Decimal?        @db.Decimal(18, 2)
  tax           Decimal?        @db.Decimal(18, 2)
  currency      String          @default("INR")
  hash          String          @unique
  paymentId     String?
  GatewayImport GatewayImport   @relation(fields: [importId], references: [id], onDelete: Cascade)
  Payment       Payment?        @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([ref])
  @@index([txnDate])
}

model GroupBooking {
  id                      String                    @id @default(cuid())
  tutorId          String
  startTime        DateTime
  endTime          DateTime
  maxStudents      Int                @default(4)
  topic            String?
  status           BookingStatus      @default(PENDING)
  createdAt        DateTime           @default(now())
  Tutor            Tutor              @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  GroupParticipant GroupParticipant[]

  @@index([tutorId, startTime])
}

model GroupBookingParticipant {
  id                      String                    @id @default(cuid())
  bookingId     String
  studentId     String
  joinedAt      DateTime @default(now())
  tokensPaid    Decimal  @default(0.00) @db.Decimal(18, 2)
  pricePerToken Decimal  @default(0.00) @db.Decimal(10, 2)
  status        String   @default("ENROLLED")
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([bookingId, studentId])
  @@index([bookingId])
  @@index([studentId])
}

model GroupParticipant {
  id                      String                    @id @default(cuid())
  groupBookingId String
  studentId      String
  paymentStatus  PaymentStatus @default(PENDING)
  paidAmount     Decimal       @db.Decimal(18, 2)
  joinedAt       DateTime      @default(now())
  groupBooking   GroupBooking  @relation(fields: [groupBookingId], references: [id], onDelete: Cascade)
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([groupBookingId, studentId])
  @@index([studentId])
}

model KycDocument {
  id                      String                    @id @default(cuid())
  tutorId   String
  docType   String
  url       String
  status    KycStatus @default(PENDING)
  notes     String?
  createdAt DateTime  @default(now())
  tutor     Tutor     @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId, status, createdAt])
}

model LearningGoal {
  id                      String                    @id @default(cuid())
  studentId   String
  title       String
  description String?
  targetDate  DateTime?
  status      GoalStatus  @default(IN_PROGRESS)
  progress    Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt               DateTime                  @default(now()) @updatedAt
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  milestones  Milestone[]

  @@index([studentId, status])
}

model MaterialAccess {
  id                      String                    @id @default(cuid())
  materialId    String
  studentId     String
  accessedAt    DateTime      @default(now())
  studyMaterial StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([materialId, studentId])
  @@index([studentId])
}

model MeetingLink {
  id                      String                    @id @default(cuid())
  bookingId String   @unique
  meetUrl   String
  meetId    String
  createdAt DateTime @default(now())
  Booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Message {
  id                      String                    @id @default(cuid())
  conversationId    String
  senderId          String
  text              String              @db.VarChar(2000)
  createdAt         DateTime            @default(now())
  conversation      Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  messageAttachments MessageAttachment[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model MessageAttachment {
  id                      String                    @id @default(cuid())
  messageId String
  fileUrl   String
  fileName  String
  fileSize  Int
  fileType  String
  createdAt DateTime @default(now())
  Message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model Milestone {
  id                      String                    @id @default(cuid())
  goalId       String
  title        String
  completed    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  goal         LearningGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model Notification {
  id                      String                    @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  bookingId String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  booking   Booking?         @relation(fields: [bookingId], references: [id])
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model OAuthAccount {
  id                      String                    @id @default(cuid())
  userId         String
  provider       String
  providerUserId String   @unique
  email          String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
}

model OtpCode {
  id                      String                    @id @default(cuid())
  userId     String
  purpose    OtpPurpose @default(PASSWORD_RESET)
  channel    OtpChannel
  target     String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())
  User       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code, target])
  @@index([target, purpose, expiresAt])
  @@index([userId, createdAt])
}

model Payment {
  id                      String                    @id @default(cuid())
  currency          String          @default("INR")
  status            PaymentStatus   @default(PENDING)
  createdAt         DateTime        @default(now())
  amountInMinor     Int
  metadata          Json?
  providerOrderId   String?
  providerPaymentId String?
  providerSignature String?
  tokensPurchased   Int             @default(0)
  updatedAt               DateTime                  @default(now()) @updatedAt
  userId            String
  provider          PaymentProvider
  bankTxns          BankTxn[]
  gatewayTxns       GatewayTxn[]
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  refunds           Refund[]
  tokenLedger       TokenLedger[]

  @@index([userId])
  @@index([userId, status, createdAt])
}

model Payout {
  id                      String                    @id @default(cuid())
  tutorId   String
  amount    Decimal      @db.Decimal(18, 2)
  status    PayoutStatus @default(PENDING)
  reference String?
  createdAt DateTime     @default(now())
  paidAt    DateTime?
  tutor     Tutor        @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId, createdAt])
}

model PerformanceReport {
  id                      String                    @id @default(cuid())
  studentId String
  tutorId   String?
  period    String
  data      Json
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutor     Tutor?   @relation(fields: [tutorId], references: [id])

  @@index([studentId, createdAt])
}

model PromoCode {
  id                      String                    @id @default(cuid())
  code       String       @unique
  discount   Decimal      @db.Decimal(10, 2)
  type       DiscountType
  maxUses    Int?
  usedCount  Int          @default(0)
  validFrom  DateTime
  validUntil DateTime
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  PromoUsage PromoUsage[]

  @@index([code, isActive])
}

model PromoUsage {
  id                      String                    @id @default(cuid())
  promoId   String
  userId    String
  usedAt    DateTime  @default(now())
  promoCode PromoCode @relation(fields: [promoId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([promoId])
  @@index([userId])
}

model ReconAdjustment {
  id                      String                    @id @default(cuid())
  date      DateTime
  ref       String?
  side      ReconSide
  amount    Decimal   @db.Decimal(18, 2)
  reason    String
  createdAt DateTime  @default(now())
  createdBy String?
  User      User?     @relation(fields: [createdBy], references: [id])

  @@index([date])
  @@index([ref])
  @@index([side, date])
}

model RecurringBooking {
  id                      String                    @id @default(cuid())
  studentId    String
  tutorId      String
  dayOfWeek    Int
  startTime    String
  endTime      String
  occurrences  Int
  currentCount Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutor        Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([studentId, isActive])
  @@index([tutorId, isActive])
}

model RecurringTemplate {
  id                      String                    @id @default(cuid())
  tutorId            String
  dayOfWeek          Int
  startTime          String
  endTime            String
  title              String?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  lastGeneratedDate  DateTime?
  nextGenerationDate DateTime?
  maxGroupSize       Int       @default(1)
  isGroupSession     Boolean   @default(false)
  pricePerStudent    Decimal?  @db.Decimal(18, 2)
  bookings           Booking[]
  tutor              Tutor     @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([nextGenerationDate, isActive])
  @@index([tutorId, isActive])
}

model Referral {
  id                      String                    @id @default(cuid())
  referrerId                           String
  referredEmail                        String
  referredId                           String?
  referralCode                         String         @unique
  tokensEarned                         Int            @default(0)
  referredUserBonus                    Int            @default(0)
  status                               ReferralStatus @default(PENDING)
  firstPaidSessionId                   String?
  createdAt                            DateTime       @default(now())
  completedAt                          DateTime?
  Student_Referral_referredIdToStudent Student?       @relation("Referral_referredIdToStudent", fields: [referredId], references: [id])
  Student_Referral_referrerIdToStudent Student        @relation("Referral_referrerIdToStudent", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referredEmail])
  @@index([referrerId])
  @@index([referralCode])
}

model Refund {
  id                      String                    @id @default(cuid())
  paymentId        String
  amountInMinor    Int
  providerRefundId String?
  reason           String?
  createdAt        DateTime @default(now())
  Payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model Reminder {
  id                      String                    @id @default(cuid())
  bookingId String
  kind      String
  sentAt    DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, kind])
  @@index([sentAt])
}

model Review {
  id                      String                    @id @default(cuid())
  tutorId   String
  studentId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  bookingId String   @unique
  isDeleted Boolean? @default(false)
  updatedAt DateTime? @default(now()) @updatedAt
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutor     Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([tutorId, createdAt])
}

model Session {
  id                      String                    @id @default(cuid())
  tutorId   String
  studentId String
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id])
  tutor     Tutor    @relation(fields: [tutorId], references: [id])
}

model SessionNote {
  id                      String                    @id @default(cuid())
  bookingId       String
  authorId        String
  content         String
  aiSummary       String?
  keyPoints       String?
  homeworkSuggestions String?
  isAiGenerated   Boolean  @default(false)
  approvedByTutor Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt               DateTime                  @default(now()) @updatedAt
  author          User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Student {
  id                      String                    @id @default(cuid())
  userId                                String                    @unique
  grade                                 String?
  board                                 String?
  tokens                                Int                       @default(0)
  bio                                   String?
  timezone                              String?
  preferredLanguage                     String?
  createdAt                             DateTime                  @default(now())
  updatedAt               DateTime                  @default(now()) @updatedAt
  student_sid                           String?                   @unique(map: "student_sid_unique") @map("student_sid")
  assignments                           Assignment[]
  bookings                              Booking[]
  certificates                          Certificate[]
  conversationsAsStudent                Conversation[]
  favoriteTutors                        FavoriteTutor[]
  groupBookingParticipants              GroupBookingParticipant[]
  groupParticipants                     GroupParticipant[]
  learningGoals                         LearningGoal[]
  materialAccess                        MaterialAccess[]
  performanceReports                    PerformanceReport[]
  recurringBookings                     RecurringBooking[]
  referralsReceived                     Referral[]                @relation("Referral_referredIdToStudent")
  referralsMade                         Referral[]                @relation("Referral_referrerIdToStudent")
  reviews                               Review[]
  sessions                              Session[]
  user                                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress                              StudentProgress[]
  tokenLedger                           TokenLedger[]
  tutorTokenBalances                    TutorTokenBalance[]
  waitlist                              Waitlist[]
  tokenTransferRequests                 TokenTransferRequest[]
  refundRequests                        RefundRequest[]
  availabilityAlerts                    TutorAvailabilityAlert[]

  @@index([createdAt])
  @@index([userId])
}

model StudentProgress {
  id                      String                    @id @default(cuid())
  studentId  String
  subject    String
  hoursSpent Decimal  @default(0) @db.Decimal(10, 2)
  level      Int      @default(1)
  xp         Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt               DateTime                  @default(now()) @updatedAt
  Student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, subject])
  @@index([studentId])
}

model StudyMaterial {
  id                      String                    @id @default(cuid())
  tutorId        String
  title          String
  description    String?
  fileUrl        String
  fileType       String
  subject        String?
  isPublic       Boolean          @default(false)
  downloads      Int              @default(0)
  createdAt      DateTime         @default(now())
  access         MaterialAccess[]
  tutor          Tutor            @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([subject])
  @@index([tutorId, isPublic])
}

model TokenLedger {
  id                      String                    @id @default(cuid())
  studentId String
  delta     Decimal     @db.Decimal(10, 2)
  reason    TokenReason
  bookingId String?
  paymentId String?
  createdAt DateTime    @default(now())
  expiresAt DateTime?   // Token expiration date (60 days after purchase for PURCHASED tokens)
  tutorId   String?
  description String?
  booking   Booking?    @relation(fields: [bookingId], references: [id])
  payment   Payment?    @relation(fields: [paymentId], references: [id])
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutor     Tutor?      @relation(fields: [tutorId], references: [id])

  @@index([bookingId])
  @@index([paymentId])
  @@index([studentId, createdAt])
  @@index([tutorId])
  @@index([expiresAt])
}

model Tutor {
  id                      String                    @id @default(cuid())
  userId              String                @unique
  bio                 String?
  summary             String?
  subjects            String[]              @default([])
  boards              String[]              @default([])
  classSubjectMappings Json?
  languages           String[]              @default([])
  degrees             String[]              @default([])
  classesTeach        String[]              @default([])
  qualifications      String?
  yearsExperience     Int?
  createdAt           DateTime              @default(now())
  hourlyRate          Int                   @default(0)
  updatedAt               DateTime                  @default(now()) @updatedAt
  status              TutorStatus           @default(PENDING)
  country             String?
  isTrending          Boolean               @default(false)
  tutorTid            String?               @unique(map: "tutor_tid_unique") @map("tutor_tid")
  demeritPoints       Int                   @default(0)
  lastDemeritReset    DateTime?
  assignments         Assignment[]
  slots               AvailabilitySlot[]
  bookings            Booking[]
  certificates        Certificate[]
  conversationsAsTutor Conversation[]
  favoritedBy         FavoriteTutor[]
  groupBookings       GroupBooking[]
  kycDocs             KycDocument[]
  payouts             Payout[]
  reports             PerformanceReport[]
  recurringBookings   RecurringBooking[]
  recurringTemplates  RecurringTemplate[]
  reviews             Review[]
  sessions            Session[]
  studyMaterials      StudyMaterial[]
  tokenLedger         TokenLedger[]
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  kycApplications     TutorKycApplication[]
  balances            TutorTokenBalance[]
  wallet              TutorWallet?
  walletLedger        TutorWalletLedger[]
  waitlist            Waitlist[]
  lastActiveDate      DateTime?
  availabilityConsistency Decimal? @db.Decimal(5, 2)
  isFeatured          Boolean @default(false)
  isVerified          Boolean @default(false)
  weeklyAvailabilityHours Decimal? @db.Decimal(5, 2)
  lastAvailabilityUpdate DateTime?
  tokenTransferRequestsFrom TokenTransferRequest[] @relation("FromTutor")
  tokenTransferRequestsTo TokenTransferRequest[] @relation("ToTutor")
  refundRequests      RefundRequest[]
  availabilityAlerts  TutorAvailabilityAlert[]
  isAutoSuspended     Boolean?                  @default(false)
  noShowCount         Int?                      @default(0)

  @@index([country])
  @@index([hourlyRate])
  @@index([isTrending, updatedAt])
  @@index([status, updatedAt])
  @@index([userId])
  @@index([lastActiveDate])
  @@index([isFeatured])
  @@index([isVerified])
}

model TutorKycApplication {
  id                      String                    @id @default(cuid())
  tutorId           String
  createdAt         DateTime     @default(now())
  updatedAt               DateTime                  @default(now()) @updatedAt
  status            KycAppStatus @default(SUBMITTED)
  rejectionCount    Int          @default(0)
  reapplyAfter      DateTime?
  notes             String?
  fullName          String
  dob               DateTime
  phone             String
  country           String
  address1          String
  address2          String?
  city              String
  state             String?
  postalCode        String?
  bankAccountHolder String
  bankName          String
  bankBranch        String?
  accountNumber     String?
  ifsc              String?
  upiId             String?
  aadhaarNumber     String?
  iban              String?
  swift             String?
  tutor             Tutor        @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId, status, updatedAt])
}

model TutorTokenBalance {
  id                      String                    @id @default(cuid())
  studentId     String
  tutorId       String
  balance       Decimal @db.Decimal(10, 2)
  pricePerToken Decimal @db.Decimal(10, 2)
  student       Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutor         Tutor   @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([studentId, tutorId])
  @@index([studentId, tutorId])
  @@index([studentId, balance(sort: Desc)])
}

model TutorWallet {
  tutorId   String   @id
  balance   Decimal  @default(0.0) @db.Decimal(18, 2)
  updatedAt               DateTime                  @default(now()) @updatedAt
  tutor     Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
}

model TutorWalletLedger {
  id                      String                    @id @default(cuid())
  tutorId   String
  bookingId String?
  delta     Decimal      @db.Decimal(18, 2)
  reason    WalletReason
  note      String?
  createdAt DateTime     @default(now())
  booking   Booking?     @relation(fields: [bookingId], references: [id])
  tutor     Tutor        @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([tutorId, createdAt])
  @@unique([tutorId, bookingId, reason])
}

model User {
  id                      String                    @id @default(cuid())
  email                            String            @unique
  password                         String
  role                             Role?
  isDirector                       Boolean           @default(false)
  isBanned                         Boolean           @default(false)
  bannedScope                      BanScope?
  bannedAt                         DateTime?
  createdAt                        DateTime          @default(now())
  updatedAt               DateTime                  @default(now()) @updatedAt
  avatarUrl                        String?
  name                             String?
  phone                            String?           @unique
  hasChosenRole                    Boolean           @default(false)
  preferredCurrency                String            @default("INR")
  failedLoginAttempts              Int               @default(0)
  lockUntil                        DateTime?
  bankImports                      BankImport[]
  disputesReported                 Dispute[]         @relation("Dispute_reporterIdToUser")
  disputesResolved                 Dispute[]         @relation("Dispute_resolvedByToUser")
  emailCampaigns                   EmailCampaign[]
  gatewayImports                   GatewayImport[]
  messages                         Message[]
  notifications                    Notification[]
  oauthAccounts                    OAuthAccount[]
  otpCodes                         OtpCode[]
  payments                         Payment[]
  promoUsages                      PromoUsage[]
  reconAdjustments                 ReconAdjustment[]
  sessionNotes                     SessionNote[]
  student                          Student?
  tutor                            Tutor?
  piiViolationLogs                 PiiViolationLog[]
  banEvents                        BanLedger[]
  banActions                       BanLedger[]       @relation("BanActor")
  forfeitureLedger                 BanForfeitureLedger[]
  supportTickets                   SupportTicket[]   @relation("SupportTicketUser")
  supportTicketsAssigned           SupportTicket[]   @relation("SupportTicketAssignee")
  supportMessages                  SupportMessage[]
  auditLogs                        AuditLog[]        @relation("AuditLogAdmin")
  tokenTransferRequests            TokenTransferRequest[]
  refundRequests                   RefundRequest[]

  @@index([email])
  @@index([role, hasChosenRole])
  @@index([isBanned])
}

model AuditLog {
  id         String           @id @default(cuid())
  adminId    String
  action     String
  entityType AuditEntityType
  entityId   String
  beforeData Json?
  afterData  Json?
  endpoint   String?
  ipAddress  String?
  createdAt  DateTime         @default(now())
  admin      User             @relation("AuditLogAdmin", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@index([entityType, createdAt])
}

model TokenTransferRequest {
  id          String   @id @default(cuid())
  studentId   String
  fromTutorId String
  toTutorId   String
  tokenAmount Decimal  @db.Decimal(18, 2)
  reason      String?
  status      String   @default("PENDING")
  adminId     String?
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  processedAt DateTime?
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromTutor   Tutor    @relation("FromTutor", fields: [fromTutorId], references: [id], onDelete: Cascade)
  toTutor     Tutor    @relation("ToTutor", fields: [toTutorId], references: [id], onDelete: Cascade)
  admin       User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([status])
  @@index([createdAt])
}

model RefundRequest {
  id          String   @id @default(cuid())
  studentId   String
  tutorId     String
  tokenAmount Decimal  @db.Decimal(18, 2)
  reason      String?
  status      String   @default("PENDING")
  adminId     String?
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  processedAt DateTime?
  purchaseDate DateTime
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutor       Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  admin       User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([status])
  @@index([createdAt])
}

model TutorAvailabilityAlert {
  id              String   @id @default(cuid())
  tutorId         String
  studentId       String
  alertType       String
  tokenAmount     Decimal? @db.Decimal(18, 2)
  sentAt          DateTime @default(now())
  acknowledgedAt  DateTime?
  refundRequested Boolean  @default(false)
  tutor           Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tutorId])
  @@index([studentId])
  @@index([alertType])
}

model BanLedger {
  id          String     @id @default(cuid())
  userId      String
  actorId     String
  actorRole   Role       @default(ADMIN)
  scope       BanScope
  reason      String
  note        String?
  bannedAt    DateTime   @default(now())
  liftedAt    DateTime?
  liftReason  String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor       User       @relation("BanActor", fields: [actorId], references: [id])
  forfeitures BanForfeitureLedger[]

  @@index([userId, isActive])
  @@index([actorId])
  @@index([scope])
}

model BanForfeitureLedger {
  id          String               @id @default(cuid())
  userId      String
  amount      Decimal              @db.Decimal(18, 2)
  type        BanForfeitureType
  banLedgerId String
  createdAt   DateTime             @default(now())
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  banLedger   BanLedger            @relation(fields: [banLedgerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([banLedgerId])
}

model Waitlist {
  id                      String                    @id @default(cuid())
  tutorId            String
  studentId          String
  requestedStartTime DateTime
  requestedEndTime   DateTime
  subject            String?
  priority           Int       @default(1)
  status             String    @default("WAITING")
  createdAt          DateTime  @default(now())
  updatedAt               DateTime                  @default(now()) @updatedAt
  notifiedAt         DateTime?
  expiresAt          DateTime?
  bookingId          String?
  notes              String?
  booking            Booking?  @relation(fields: [bookingId], references: [id])
  student            Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutor              Tutor     @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([requestedStartTime])
  @@index([status])
  @@index([studentId])
  @@index([tutorId])
}

model SupportTicket {
  id            String               @id @default(cuid())
  ticketNumber  Int                  @unique @default(autoincrement())
  userId        String
  assignedToId  String?
  status        SupportTicketStatus  @default(OPEN)
  subject       String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @default(now()) @updatedAt
  lastMessageAt DateTime             @default(now())

  user          User                 @relation("SupportTicketUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo    User?                @relation("SupportTicketAssignee", fields: [assignedToId], references: [id])
  messages      SupportMessage[]

  @@index([userId, createdAt])
  @@index([assignedToId, status, updatedAt])
  @@index([status, updatedAt])
}

model SupportMessage {
  id        String       @id @default(cuid())
  ticketId  String
  senderId  String
  message   String       @db.Text
  createdAt DateTime     @default(now())

  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([senderId])
}

model WhiteboardSession {
  id                      String                    @id @default(cuid())
  bookingId String   @unique
  data      Json?
  s3Url     String?
  noteName  String?
  sharedAt  DateTime?
  endedAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt               DateTime                  @default(now()) @updatedAt
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model PiiViolationLog {
  id                 String   @id @default(cuid())
  userId             String
  messageContent     String   @db.Text
  violationType      String
  detectedPatterns   Json
  action             String   @default("BLOCKED")
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

enum AiScanStatus {
