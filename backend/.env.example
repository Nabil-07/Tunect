# ==========================================
# TUNECT - Environment Configuration
# ==========================================

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/tunect_dev"

# JWT
JWT_SECRET="your-secret-key-here-change-in-production"

# AWS S3 Configuration
ENABLE_S3=false  # Set to 'true' in production
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=tunect-files
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# OpenAI Configuration
ENABLE_OPENAI=false  # Set to 'true' to enable AI features
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini  # or gpt-4

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Google OAuth (for tutors/students)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Email (optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Release flag: disable non-critical notification emails (waitlist/booking reminders, etc.)
# OTP/password reset emails are still sent via NotificationsService.sendOtpEmail.
DISABLE_NOTIFICATION_EMAILS=false

# Email (recommended) - Microsoft Graph OAuth2
# Avoids SMTP basic auth issues (Security Defaults / MFA).
# Entra App Registration needs: Microsoft Graph -> Application permission: Mail.Send
# Then "Grant admin consent".
ENABLE_GRAPH_EMAIL=false
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_UPN=no-reply@tunectnow.com
GRAPH_SAVE_TO_SENT_ITEMS=false

# Node Environment
NODE_ENV=development  # development | test | production

# ==========================================
# ENVIRONMENT-SPECIFIC NOTES:
# ==========================================
# TEST (Railway):
#   - DATABASE_URL: Railway PostgreSQL
#   - ENABLE_S3: false (use mock)
#   - ENABLE_OPENAI: true (for testing AI features)
#
# PRODUCTION (AWS):
#   - DATABASE_URL: AWS RDS PostgreSQL
#   - ENABLE_S3: true
#   - ENABLE_OPENAI: true
#   - All secrets must be in AWS Secrets Manager
# ==========================================
