# ==========================================
# TUNECT - TEST ENVIRONMENT (RAILWAY)
# ==========================================
# Use this for testing on Railway deployment
# This is your staging/test environment

NODE_ENV=test

# ==========================================
# DATABASE - Railway PostgreSQL
# ==========================================
DATABASE_URL="postgresql://postgres:ReKLitvhgRnNvNnGZxonkekoeUghJMCx@gondola.proxy.rlwy.net:20241/railway?schema=public&connection_limit=10&pool_timeout=20&connect_timeout=10"
SHADOW_DATABASE_URL="postgresql://postgres:ReKLitvhgRnNvNnGZxonkekoeUghJMCx@gondola.proxy.rlwy.net:20241/railway?schema=public"

# ==========================================
# APPLICATION
# ==========================================
APP_URL=https://tunect-test.railway.app
FRONTEND_URL=https://test.tunectnow.com
PORT=3000

# ==========================================
# JWT AUTHENTICATION
# ==========================================
JWT_SECRET=test-env-secret-key-change-me
JWT_EXPIRES_IN=7d
JWT_ISS=tunect-api-test
JWT_AUD=tunect-web-test
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d

# ==========================================
# GOOGLE OAUTH
# ==========================================
GOOGLE_CLIENT_ID=61366299037-ca52dnems0271otu47bbdahqbj8r491o.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
AUTH_GOOGLE_CALLBACK_PATH=/auth/google/callback
AUTH_SUCCESS_REDIRECT=/auth/callback
AUTH_FAILURE_REDIRECT=/login?error=google_failed

# ==========================================
# PAYMENT GATEWAY - Razorpay Test Mode
# ==========================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=whsec_your_webhook_secret
CURRENCY=INR
PURCHASE_MIN_TOKENS=5

# ==========================================
# AWS S3 - DISABLED (Use Mock for Testing)
# ==========================================
ENABLE_S3=false              # Mock S3 for testing
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=tunect-files-test
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ==========================================
# OPENAI - ENABLED for Testing AI Features
# ==========================================
ENABLE_OPENAI=true           # Enable AI for testing
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# ==========================================
# EMAIL / SMTP - Test Configuration
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=test@tunectnow.com
SMTP_PASS=your-test-app-password
MAIL_FROM="Tunect Test <no-reply@test.tunectnow.com>"

# ==========================================
# OPTIONAL SERVICES
# ==========================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/test

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

