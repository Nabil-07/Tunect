# ==========================================
# TUNECT - PRE-PRODUCTION (AWS Sandbox)
# ==========================================
# Environment: Pre-production testing on AWS
# Database: AWS RDS PostgreSQL (sandbox)
# Usage: For AWS staging/testing before production
# ==========================================

NODE_ENV=preprod

# ==========================================
# DATABASE - AWS RDS PostgreSQL (Sandbox)
# ==========================================
DATABASE_URL="postgresql://postgres:ReKLitvhgRnNvNnGZxonkekoeUghJMCx@gondola.proxy.rlwy.net:20241/railway?schema=public&connection_limit=10&pool_timeout=20&connect_timeout=10&sslmode=require"
SHADOW_DATABASE_URL="postgresql://postgres:ReKLitvhgRnNvNnGZxonkekoeUghJMCx@gondola.proxy.rlwy.net:20241/railway?schema=public&sslmode=require"
# ==========================================
# APPLICATION
# ==========================================
APP_URL=https://api-preprod.tunectnow.com
FRONTEND_URL=https://tn-internal-7f3a.preprod.tunectnow.com/
PORT=80

# ==========================================
# JWT AUTHENTICATION
# ==========================================
JWT_SECRET=preprod-secret-use-env-vars-in-deployment
JWT_EXPIRES_IN=7d
JWT_ISS=tunect-api
JWT_AUD=tunect-web
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d

# ==========================================
# GOOGLE OAUTH
# ==========================================
GOOGLE_CLIENT_ID=61366299037-ca52dnems0271otu47bbdahqbj8r491o.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
AUTH_GOOGLE_CALLBACK_PATH=/auth/google/callback
AUTH_SUCCESS_REDIRECT=/auth/callback
AUTH_FAILURE_REDIRECT=/login?error=google_failed

# ==========================================
# PAYMENT GATEWAY - Razorpay Test Mode
# ==========================================
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxx
CURRENCY=INR
PURCHASE_MIN_TOKENS=10

# ==========================================
# AWS S3 - ENABLED with Sandbox Bucket
# ==========================================
ENABLE_S3=true
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=tunect-files-preprod
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# OPENAI - ENABLED with Lower Limits
# ==========================================
ENABLE_OPENAI=true
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# ==========================================
# EMAIL / SMTP
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@tunectnow.com
SMTP_PASS=your_app_password
MAIL_FROM="Tunect PreProd <noreply@tunectnow.com>"

# ==========================================
# MONITORING & SERVICES
# ==========================================
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ==========================================
# WEBRTC / TURN / MEDIASOUP
# ==========================================
STUN_SERVERS=stun:stun.l.google.com:19302
TURN_ENABLED=true
TURN_URIS=turn:turn-preprod.tunectnow.com:3478?transport=udp,turn:turn-preprod.tunectnow.com:3478?transport=tcp
TURN_URLS=turn:turn-preprod.tunectnow.com:3478?transport=udp,turn:turn-preprod.tunectnow.com:3478?transport=tcp
TURN_REALM=tunect-preprod
TURN_REST_SECRET=9fA7KqR4D2mZC8xP6LwJbYtH5SNeUeV0cXg1rQWk
TURN_TTL_SECONDS=600
WEBRTC_DEBUG=true
MEDIASOUP_ENABLED=false
MEDIASOUP_LOG_LEVEL=warn
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=49999
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=
